#
# 이 파일을 `.env` 로 복사한 뒤 실제 값을 채우세요.  cp .env.example .env
#
# ⚠️ 절대로 `.env`(실제 키)를 커밋하지 마세요. .gitignore 가 제외합니다.
# ⚠️ API 키는 오직 이 서버(백엔드)에만 존재해야 합니다. 브라우저/저장소 금지.

# Anthropic API 키 (필수). "sk-ant-" 로 시작합니다. 저장소·브라우저에 넣지 마세요.
ANTHROPIC_API_KEY=<your-anthropic-api-key-here>

# 사용할 모델. 비용 우선 기본값 = claude-haiku-4-5 (약 $1/$5 per MTok).
# 품질이 더 필요하면 claude-sonnet-5 또는 claude-opus-5 로 올리세요(비용 증가).
AI_MODEL=claude-haiku-4-5

# sonnet/opus 용 effort (Haiku 는 thinking/effort 를 받지 않으므로 무시됨).
AI_EFFORT=low

# 비용 가드레일.
AI_RATE_LIMIT=20               # IP당 분당 최대 요청 수
AI_MONTHLY_TOKEN_CAP=2000000   # 월 토큰 예산; 초과 시 → 429 {fallback:true}

# 프록시 포트 (선택, 기본 8787).
PORT=8787

# CORS 허용 오리진 (운영에서는 프론트엔드 도메인으로 좁히세요; 로컬은 "*").
CORS_ORIGIN=*
