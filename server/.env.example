#
# 이 파일을 `.env` 로 복사한 뒤 실제 값을 채우세요.  cp .env.example .env
#
# ⚠️ 절대로 `.env`(실제 키)를 커밋하지 마세요. .gitignore 가 제외합니다.
# ⚠️ API 키는 오직 이 서버(백엔드)에만 존재해야 합니다. 브라우저/저장소 금지.

# Anthropic API 키 (필수). 콘솔에서 발급받은 값을 넣으세요.
ANTHROPIC_API_KEY=sk-ant-<your-api-key-here>

# 프록시 포트 (선택, 기본 8787)
PORT=8787

# CORS 허용 오리진 (선택, 기본 *). 운영에서는 프론트엔드 도메인으로 좁히세요.
AI_ALLOW_ORIGIN=*
